route replace 10.200.0.17/32 via 10.100.0.70 dev eth4
route replace 10.200.0.18/32 via 10.100.0.58 dev eth1
route replace 10.200.0.19/32 via 10.100.0.58 dev eth1
route replace 10.200.0.20/32 via 10.100.0.58 dev eth1
route replace 10.200.0.21/32 via 10.100.0.58 dev eth1
route replace 10.200.0.22/32 via 10.100.0.58 dev eth1
route replace 10.200.0.23/32 via 10.100.0.62 dev eth2
route replace 10.200.0.24/32 via 10.100.0.62 dev eth2
route replace 10.200.0.25/32 via 10.100.0.54 dev eth0
route replace 10.200.0.26/32 via 10.100.0.66 dev eth3
route replace 10.200.0.27/32 via 10.100.0.58 dev eth1
route replace 10.200.0.28/32 via 10.100.0.66 dev eth3
route replace 10.200.0.29/32 via 10.100.0.66 dev eth3
route replace 10.200.0.30/32 via 10.100.0.58 dev eth1
route replace 10.200.0.31/32 via 10.100.0.66 dev eth3
route replace 10.200.0.32/32 via 10.100.0.54 dev eth0
route replace 10.200.0.33/32 via 10.100.0.58 dev eth1
route replace 10.200.0.34/32 via 10.100.0.66 dev eth3
route replace 10.200.0.35/32 via 10.100.0.70 dev eth4
route replace 10.200.0.36/32 via 10.100.0.66 dev eth3
route replace 10.200.0.37/32 via 10.100.0.58 dev eth1
COST266_ROUTES

echo "[COST266] READY r_berlin: 6 IPv4 addresses, 88 static routes"
if [ "$(cat /proc/sys/net/ipv4/ip_forward)" != "1" ]; then
  echo "[COST266] WARNING: IPv4 forwarding remains disabled"
fi
