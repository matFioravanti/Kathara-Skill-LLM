#!/bin/sh
# COST266 European backbone | r_marseille | static IPv4 routing
# Reconstructed from the working COST266 topology and verified against correction.yaml.
set -eu
exec > /tmp/cost266-r_marseille-startup.log 2>&1
echo "[COST266] START r_marseille"

# Apply all interface addresses using one iproute2 invocation.
ip -4 -batch - <<'COST266_ADDRESSES'
address replace 10.200.0.22/32 dev lo
address replace 10.100.0.34/30 dev eth0
address replace 10.100.0.86/30 dev eth1
address replace 10.100.0.174/30 dev eth2
address replace 10.100.0.185/30 dev eth3
COST266_ADDRESSES

# Forwarding is enabled by lab.conf; try to enforce it here as well.
if [ "$(cat /proc/sys/net/ipv4/ip_forward)" != "1" ]; then
  if ! sysctl -q -w net.ipv4.ip_forward=1; then
    echo "[COST266] WARNING: cannot enable IPv4 forwarding from startup"
  fi
fi
# Disable strict reverse-path filtering, including the already-created eth interfaces.
for flag in /proc/sys/net/ipv4/conf/*/rp_filter; do
  [ -e "$flag" ] || continue
  if ! printf "0\n" > "$flag"; then
    echo "[COST266] WARNING: cannot disable rp_filter on $flag"
  fi
done

# Apply all original static routes as one atomic batch of iproute2 commands.
# ip -batch exits non-zero if applying a route fails; the log identifies the failed line.
ip -4 -batch - <<'COST266_ROUTES'
route replace 10.100.0.0/30 via 10.100.0.173 dev eth2
route replace 10.100.0.4/30 via 10.100.0.173 dev eth2
route replace 10.100.0.8/30 via 10.100.0.173 dev eth2
route replace 10.100.0.12/30 via 10.100.0.173 dev eth2
route replace 10.100.0.16/30 via 10.100.0.186 dev eth3
route replace 10.100.0.20/30 via 10.100.0.186 dev eth3
route replace 10.100.0.24/30 via 10.100.0.186 dev eth3
route replace 10.100.0.28/30 via 10.100.0.33 dev eth0
route replace 10.100.0.36/30 via 10.100.0.33 dev eth0
route replace 10.100.0.40/30 via 10.100.0.186 dev eth3
route replace 10.100.0.44/30 via 10.100.0.186 dev eth3
route replace 10.100.0.48/30 via 10.100.0.186 dev eth3
route replace 10.100.0.52/30 via 10.100.0.173 dev eth2
route replace 10.100.0.56/30 via 10.100.0.173 dev eth2
route replace 10.100.0.60/30 via 10.100.0.173 dev eth2
route replace 10.100.0.64/30 via 10.100.0.173 dev eth2
route replace 10.100.0.68/30 via 10.100.0.173 dev eth2
route replace 10.100.0.72/30 via 10.100.0.173 dev eth2
route replace 10.100.0.76/30 via 10.100.0.173 dev eth2
route replace 10.100.0.80/30 via 10.100.0.85 dev eth1
route replace 10.100.0.88/30 via 10.100.0.85 dev eth1
route replace 10.100.0.92/30 via 10.100.0.173 dev eth2
route replace 10.100.0.96/30 via 10.100.0.173 dev eth2
route replace 10.100.0.100/30 via 10.100.0.186 dev eth3
route replace 10.100.0.104/30 via 10.100.0.186 dev eth3
route replace 10.100.0.108/30 via 10.100.0.173 dev eth2
route replace 10.100.0.112/30 via 10.100.0.173 dev eth2
route replace 10.100.0.116/30 via 10.100.0.173 dev eth2
route replace 10.100.0.120/30 via 10.100.0.173 dev eth2
route replace 10.100.0.124/30 via 10.100.0.173 dev eth2
route replace 10.100.0.128/30 via 10.100.0.173 dev eth2
route replace 10.100.0.132/30 via 10.100.0.173 dev eth2
route replace 10.100.0.136/30 via 10.100.0.173 dev eth2
route replace 10.100.0.140/30 via 10.100.0.173 dev eth2
route replace 10.100.0.144/30 via 10.100.0.173 dev eth2
route replace 10.100.0.148/30 via 10.100.0.173 dev eth2
route replace 10.100.0.152/30 via 10.100.0.186 dev eth3
route replace 10.100.0.156/30 via 10.100.0.173 dev eth2
route replace 10.100.0.160/30 via 10.100.0.33 dev eth0
route replace 10.100.0.164/30 via 10.100.0.33 dev eth0
route replace 10.100.0.168/30 via 10.100.0.173 dev eth2
route replace 10.100.0.176/30 via 10.100.0.173 dev eth2
route replace 10.100.0.180/30 via 10.100.0.173 dev eth2
route replace 10.100.0.188/30 via 10.100.0.173 dev eth2
route replace 10.100.0.192/30 via 10.100.0.186 dev eth3
route replace 10.100.0.196/30 via 10.100.0.173 dev eth2
route replace 10.100.0.200/30 via 10.100.0.173 dev eth2
route replace 10.100.0.204/30 via 10.100.0.186 dev eth3
route replace 10.100.0.208/30 via 10.100.0.173 dev eth2
route replace 10.100.0.212/30 via 10.100.0.186 dev eth3
route replace 10.100.0.216/30 via 10.100.0.186 dev eth3
route replace 10.100.0.220/30 via 10.100.0.173 dev eth2
route replace 10.100.0.224/30 via 10.100.0.186 dev eth3
route replace 10.200.0.1/32 via 10.100.0.173 dev eth2
route replace 10.200.0.2/32 via 10.100.0.186 dev eth3
route replace 10.200.0.3/32 via 10.100.0.33 dev eth0
route replace 10.200.0.4/32 via 10.100.0.186 dev eth3
route replace 10.200.0.5/32 via 10.100.0.173 dev eth2
route replace 10.200.0.6/32 via 10.100.0.173 dev eth2
route replace 10.200.0.7/32 via 10.100.0.85 dev eth1
route replace 10.200.0.8/32 via 10.100.0.173 dev eth2
route replace 10.200.0.9/32 via 10.100.0.186 dev eth3
