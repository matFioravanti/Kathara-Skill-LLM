route replace 10.200.0.21/32 via 10.100.0.33 dev eth0
route replace 10.200.0.23/32 via 10.100.0.173 dev eth2
route replace 10.200.0.24/32 via 10.100.0.173 dev eth2
route replace 10.200.0.25/32 via 10.100.0.173 dev eth2
route replace 10.200.0.26/32 via 10.100.0.186 dev eth3
route replace 10.200.0.27/32 via 10.100.0.173 dev eth2
route replace 10.200.0.28/32 via 10.100.0.186 dev eth3
route replace 10.200.0.29/32 via 10.100.0.186 dev eth3
route replace 10.200.0.30/32 via 10.100.0.33 dev eth0
route replace 10.200.0.31/32 via 10.100.0.186 dev eth3
route replace 10.200.0.32/32 via 10.100.0.173 dev eth2
route replace 10.200.0.33/32 via 10.100.0.173 dev eth2
route replace 10.200.0.34/32 via 10.100.0.186 dev eth3
route replace 10.200.0.35/32 via 10.100.0.173 dev eth2
route replace 10.200.0.36/32 via 10.100.0.186 dev eth3
route replace 10.200.0.37/32 via 10.100.0.173 dev eth2
COST266_ROUTES

echo "[COST266] READY r_marseille: 5 IPv4 addresses, 89 static routes"
if [ "$(cat /proc/sys/net/ipv4/ip_forward)" != "1" ]; then
  echo "[COST266] WARNING: IPv4 forwarding remains disabled"
fi
