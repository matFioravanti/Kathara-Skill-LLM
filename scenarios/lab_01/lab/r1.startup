#!/bin/sh
set -eu
# r1: IPv4 statico; interfacce Kathara gia attive.

ip -4 address show dev eth0 | grep -Fq 'inet 10.11.1.1/24 ' || ip address add 10.11.1.1/24 dev eth0
ip -4 address show dev eth1 | grep -Fq 'inet 172.21.1.1/30 ' || ip address add 172.21.1.1/30 dev eth1

# Rotte statiche verso reti non direttamente connesse.
ip route replace 10.11.2.0/24 via 172.21.1.2 dev eth1
ip route replace 10.11.3.0/24 via 172.21.1.2 dev eth1
ip route replace 10.11.4.0/24 via 172.21.1.2 dev eth1
ip route replace 172.21.1.4/30 via 172.21.1.2 dev eth1
ip route replace 172.21.1.8/30 via 172.21.1.2 dev eth1

# Neighbor IPv4 permanenti: riducono i timeout ICMP causati da ARP durante il checker.
# Solo host direttamente collegati; nessuna modifica alle rotte o ai servizi DNS.
ip -4 neigh replace 10.11.1.11 lladdr 02:00:00:0a:01:02 nud permanent dev eth0
ip -4 neigh replace 10.11.1.12 lladdr 02:00:00:0a:01:03 nud permanent dev eth0
ip -4 neigh replace 10.11.1.13 lladdr 02:00:00:0a:01:04 nud permanent dev eth0
ip -4 neigh replace 10.11.1.14 lladdr 02:00:00:0a:01:05 nud permanent dev eth0
ip -4 neigh replace 10.11.1.15 lladdr 02:00:00:0a:01:06 nud permanent dev eth0
ip -4 neigh replace 172.21.1.2 lladdr 02:00:00:0b:0c:02 nud permanent dev eth1
