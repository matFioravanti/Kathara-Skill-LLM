#!/bin/sh
set -eu
# Interfacce Kathara gia attive: indirizzamento IPv4 statico.
ip -4 address show dev eth0 | grep -Fq 'inet 10.13.6.1/24 ' || ip address add 10.13.6.1/24 dev eth0
ip -4 address show dev eth1 | grep -Fq 'inet 172.23.1.10/30 ' || ip address add 172.23.1.10/30 dev eth1
ip -4 address show dev eth2 | grep -Fq 'inet 172.23.1.13/30 ' || ip address add 172.23.1.13/30 dev eth2

# Solo rotte ip route statiche, nessun demone di routing.
ip route replace 10.13.1.0/24 via 172.23.1.9 dev eth1
ip route replace 10.13.2.0/24 via 172.23.1.9 dev eth1
ip route replace 10.13.3.0/24 via 172.23.1.9 dev eth1
ip route replace 10.13.4.0/24 via 172.23.1.9 dev eth1
ip route replace 10.13.5.0/24 via 172.23.1.14 dev eth2
ip route replace 10.13.7.0/24 via 172.23.1.14 dev eth2
ip route replace 10.13.8.0/24 via 172.23.1.14 dev eth2
ip route replace 10.13.9.0/24 via 172.23.1.14 dev eth2
ip route replace 10.13.10.0/24 via 172.23.1.14 dev eth2
ip route replace 10.13.11.0/24 via 172.23.1.14 dev eth2
ip route replace 10.13.12.0/24 via 172.23.1.14 dev eth2
ip route replace 10.13.13.0/24 via 172.23.1.14 dev eth2
ip route replace 10.13.14.0/24 via 172.23.1.14 dev eth2
ip route replace 10.13.15.0/24 via 172.23.1.14 dev eth2
ip route replace 172.23.1.0/30 via 172.23.1.9 dev eth1
ip route replace 172.23.1.4/30 via 172.23.1.9 dev eth1
ip route replace 172.23.1.16/30 via 172.23.1.14 dev eth2
ip route replace 172.23.1.20/30 via 172.23.1.14 dev eth2
ip route replace 172.23.1.24/30 via 172.23.1.14 dev eth2
ip route replace 172.23.1.28/30 via 172.23.1.14 dev eth2
ip route replace 172.23.1.32/30 via 172.23.1.14 dev eth2
ip route replace 172.23.1.36/30 via 172.23.1.14 dev eth2
ip route replace 172.23.1.40/30 via 172.23.1.14 dev eth2

# Cache ARP statica verso dispositivi sullo stesso segmento Ethernet.
ip -4 neigh replace 10.13.6.11 lladdr 02:00:00:0a:06:02 nud permanent dev eth0
ip -4 neigh replace 10.13.6.12 lladdr 02:00:00:0a:06:03 nud permanent dev eth0
ip -4 neigh replace 10.13.6.13 lladdr 02:00:00:0a:06:04 nud permanent dev eth0
ip -4 neigh replace 10.13.6.14 lladdr 02:00:00:0a:06:05 nud permanent dev eth0
ip -4 neigh replace 172.23.1.9 lladdr 02:00:00:0b:34:03 nud permanent dev eth1
ip -4 neigh replace 172.23.1.14 lladdr 02:00:00:0b:45:05 nud permanent dev eth2
