#!/bin/sh
set -eu
# Le interfacce Kathara sono gia attive; configurazione IPv4 ripetibile.
ip -4 address show dev eth0 | grep -Fq 'inet 10.16.3.12/24 ' || ip address add 10.16.3.12/24 dev eth0

ip route replace default via 10.16.3.1 dev eth0

# Associazioni ARP permanenti per i dispositivi direttamente collegati.
ip -4 neigh replace 10.16.3.1 lladdr 02:00:00:aa:03:01 nud permanent dev eth0
ip -4 neigh replace 10.16.3.11 lladdr 02:00:00:aa:03:02 nud permanent dev eth0
ip -4 neigh replace 10.16.3.13 lladdr 02:00:00:aa:03:04 nud permanent dev eth0
ip -4 neigh replace 10.16.3.14 lladdr 02:00:00:aa:03:05 nud permanent dev eth0

# Prevenzione timeout di startup: warmup ICMP limitato, non bloccante.
# Non modifica route, gateway o servizi.
probe_attempt=0
while [ "$probe_attempt" -lt 8 ]; do
  if ping -n -I eth0 -c 1 -W 1 10.16.3.1 >/dev/null 2>&1; then break; fi
  probe_attempt=$((probe_attempt + 1))
  [ "$probe_attempt" -lt 8 ] || break
  sleep 1
done
