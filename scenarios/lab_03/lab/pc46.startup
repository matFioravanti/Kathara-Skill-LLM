#!/bin/sh
set -eu
# Interfacce Kathara gia attive: indirizzamento IPv4 statico.
ip -4 address show dev eth0 | grep -Fq 'inet 10.13.12.12/24 ' || ip address add 10.13.12.12/24 dev eth0

ip route replace default via 10.13.12.1 dev eth0

# Cache ARP statica verso dispositivi sullo stesso segmento Ethernet.
ip -4 neigh replace 10.13.12.1 lladdr 02:00:00:0a:0c:01 nud permanent dev eth0
ip -4 neigh replace 10.13.12.11 lladdr 02:00:00:0a:0c:02 nud permanent dev eth0
ip -4 neigh replace 10.13.12.13 lladdr 02:00:00:0a:0c:04 nud permanent dev eth0
ip -4 neigh replace 10.13.12.14 lladdr 02:00:00:0a:0c:05 nud permanent dev eth0

# Anti-timeout bootstrap: verifica limitata del gateway senza modificare le rotte.
# Anche se il router parte dopo il PC, nessun fallimento interrompe lo startup.
probe_attempt=0
while [ "$probe_attempt" -lt 8 ]; do
    if ping -n -I eth0 -c 1 -W 1 10.13.12.1 >/dev/null 2>&1; then
        break
    fi
    probe_attempt=$((probe_attempt + 1))
    [ "$probe_attempt" -lt 8 ] || break
    sleep 1
done
