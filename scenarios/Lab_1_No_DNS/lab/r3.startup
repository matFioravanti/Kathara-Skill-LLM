#!/bin/sh
set -e

# Enable IPv4 and IPv6 forwarding
sysctl -w net.ipv4.ip_forward=1 >/dev/null
sysctl -w net.ipv6.conf.all.forwarding=1 >/dev/null

ip addr replace 10.3.0.1/24 dev eth0
ip -6 addr replace fd00:3::1/64 dev eth0
ip addr replace 10.255.23.2/30 dev eth1
ip -6 addr replace fd00:ff:23::2/64 dev eth1
ip addr replace 10.255.34.1/30 dev eth2
ip -6 addr replace fd00:ff:34::1/64 dev eth2

# Static IPv4 routes
ip route replace 10.1.0.0/24 via 10.255.23.1 dev eth1
ip route replace 10.2.0.0/24 via 10.255.23.1 dev eth1
ip route replace 10.4.0.0/24 via 10.255.34.2 dev eth2
ip route replace 10.5.0.0/24 via 10.255.34.2 dev eth2

# Static IPv6 routes
ip -6 route replace fd00:1::/64 via fd00:ff:23::1 dev eth1
ip -6 route replace fd00:2::/64 via fd00:ff:23::1 dev eth1
ip -6 route replace fd00:4::/64 via fd00:ff:34::2 dev eth2
ip -6 route replace fd00:5::/64 via fd00:ff:34::2 dev eth2
