#!/bin/sh
set -eu
# IPv4 e instradamento statico; le interfacce Kathara sono già attive.
ip -4 address show dev eth0 | grep -Fq 'inet 10.15.4.1/24 ' || ip address add 10.15.4.1/24 dev eth0
ip -4 address show dev eth1 | grep -Fq 'inet 172.25.1.6/30 ' || ip address add 172.25.1.6/30 dev eth1
ip -4 address show dev eth2 | grep -Fq 'inet 172.25.1.9/30 ' || ip address add 172.25.1.9/30 dev eth2

# Rotte statiche verso reti non direttamente connesse.
ip route replace 10.15.1.0/24 via 172.25.1.5 dev eth1
ip route replace 10.15.2.0/24 via 172.25.1.5 dev eth1
ip route replace 10.15.3.0/24 via 172.25.1.5 dev eth1
ip route replace 10.15.5.0/24 via 172.25.1.10 dev eth2
ip route replace 10.15.6.0/24 via 172.25.1.10 dev eth2
ip route replace 10.15.7.0/24 via 172.25.1.10 dev eth2
ip route replace 10.15.8.0/24 via 172.25.1.10 dev eth2
ip route replace 10.15.9.0/24 via 172.25.1.10 dev eth2
ip route replace 10.15.10.0/24 via 172.25.1.10 dev eth2
ip route replace 172.25.1.0/30 via 172.25.1.5 dev eth1
ip route replace 172.25.1.12/30 via 172.25.1.10 dev eth2
ip route replace 172.25.1.16/30 via 172.25.1.10 dev eth2
ip route replace 172.25.1.20/30 via 172.25.1.10 dev eth2
ip route replace 172.25.1.24/30 via 172.25.1.10 dev eth2

# Cache ARP statica per soli vicini dello stesso dominio L2 (riduce ICMP iniziali).
ip -4 neigh replace 10.15.4.11 lladdr 02:00:00:0a:04:02 nud permanent dev eth0
ip -4 neigh replace 10.15.4.12 lladdr 02:00:00:0a:04:03 nud permanent dev eth0
ip -4 neigh replace 10.15.4.13 lladdr 02:00:00:0a:04:04 nud permanent dev eth0
ip -4 neigh replace 10.15.4.14 lladdr 02:00:00:0a:04:05 nud permanent dev eth0
ip -4 neigh replace 172.25.1.5 lladdr 02:00:00:0b:23:02 nud permanent dev eth1
ip -4 neigh replace 172.25.1.10 lladdr 02:00:00:0b:34:04 nud permanent dev eth2
