#!/bin/sh
set -eu
# IPv4 e instradamento statico; le interfacce Kathara sono già attive.
ip -4 address show dev eth0 | grep -Fq 'inet 10.12.4.1/24 ' || ip address add 10.12.4.1/24 dev eth0
ip -4 address show dev eth1 | grep -Fq 'inet 10.12.5.1/24 ' || ip address add 10.12.5.1/24 dev eth1
ip -4 address show dev eth2 | grep -Fq 'inet 172.22.1.6/30 ' || ip address add 172.22.1.6/30 dev eth2
ip -4 address show dev eth3 | grep -Fq 'inet 172.22.1.9/30 ' || ip address add 172.22.1.9/30 dev eth3

# Rotte statiche verso reti non direttamente connesse.
ip route replace 10.12.1.0/24 via 172.22.1.5 dev eth2
ip route replace 10.12.2.0/24 via 172.22.1.5 dev eth2
ip route replace 10.12.3.0/24 via 172.22.1.5 dev eth2
ip route replace 10.12.6.0/24 via 172.22.1.10 dev eth3
ip route replace 10.12.7.0/24 via 172.22.1.10 dev eth3
ip route replace 10.12.8.0/24 via 172.22.1.10 dev eth3
ip route replace 10.12.9.0/24 via 172.22.1.10 dev eth3
ip route replace 10.12.10.0/24 via 172.22.1.10 dev eth3
ip route replace 172.22.1.0/30 via 172.22.1.5 dev eth2
ip route replace 172.22.1.12/30 via 172.22.1.10 dev eth3
ip route replace 172.22.1.16/30 via 172.22.1.10 dev eth3
ip route replace 172.22.1.20/30 via 172.22.1.10 dev eth3
ip route replace 172.22.1.24/30 via 172.22.1.10 dev eth3

# Cache ARP statica per soli vicini dello stesso dominio L2 (riduce ICMP iniziali).
ip -4 neigh replace 10.12.4.11 lladdr 02:00:00:0a:04:02 nud permanent dev eth0
ip -4 neigh replace 10.12.4.12 lladdr 02:00:00:0a:04:03 nud permanent dev eth0
ip -4 neigh replace 10.12.4.13 lladdr 02:00:00:0a:04:04 nud permanent dev eth0
ip -4 neigh replace 10.12.4.14 lladdr 02:00:00:0a:04:05 nud permanent dev eth0
ip -4 neigh replace 10.12.5.11 lladdr 02:00:00:0a:05:02 nud permanent dev eth1
ip -4 neigh replace 10.12.5.12 lladdr 02:00:00:0a:05:03 nud permanent dev eth1
ip -4 neigh replace 10.12.5.13 lladdr 02:00:00:0a:05:04 nud permanent dev eth1
ip -4 neigh replace 10.12.5.14 lladdr 02:00:00:0a:05:05 nud permanent dev eth1
ip -4 neigh replace 172.22.1.5 lladdr 02:00:00:0b:23:02 nud permanent dev eth2
ip -4 neigh replace 172.22.1.10 lladdr 02:00:00:0b:34:04 nud permanent dev eth3
