#!/bin/sh
set -eu
# IPv4 e instradamento statico; le interfacce Kathara sono già attive.
ip -4 address show dev eth0 | grep -Fq 'inet 10.12.7.13/24 ' || ip address add 10.12.7.13/24 dev eth0

ip route replace default via 10.12.7.1 dev eth0

# Cache ARP statica per soli vicini dello stesso dominio L2 (riduce ICMP iniziali).
ip -4 neigh replace 10.12.7.1 lladdr 02:00:00:0a:07:01 nud permanent dev eth0
ip -4 neigh replace 10.12.7.11 lladdr 02:00:00:0a:07:02 nud permanent dev eth0
ip -4 neigh replace 10.12.7.12 lladdr 02:00:00:0a:07:03 nud permanent dev eth0
ip -4 neigh replace 10.12.7.14 lladdr 02:00:00:0a:07:05 nud permanent dev eth0
