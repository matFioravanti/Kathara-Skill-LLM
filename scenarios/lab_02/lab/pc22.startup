#!/bin/sh
set -eu
# IPv4 e instradamento statico; le interfacce Kathara sono già attive.
ip -4 address show dev eth0 | grep -Fq 'inet 10.12.6.12/24 ' || ip address add 10.12.6.12/24 dev eth0

ip route replace default via 10.12.6.1 dev eth0

# Cache ARP statica per soli vicini dello stesso dominio L2 (riduce ICMP iniziali).
ip -4 neigh replace 10.12.6.1 lladdr 02:00:00:0a:06:01 nud permanent dev eth0
ip -4 neigh replace 10.12.6.11 lladdr 02:00:00:0a:06:02 nud permanent dev eth0
ip -4 neigh replace 10.12.6.13 lladdr 02:00:00:0a:06:04 nud permanent dev eth0
ip -4 neigh replace 10.12.6.14 lladdr 02:00:00:0a:06:05 nud permanent dev eth0

# Controllo iniziale non invasivo del gateway (solo traffico ICMP, nessuna rotta aggiunta).
# Il router r4 puo' terminare lo startup dopo pc22: effettua massimo 8 tentativi,
# poi lascia proseguire il laboratorio anche se il gateway non risponde ancora.
# I test di rete saranno comunque eseguiti dal checker, non da questo controllo.
probe_attempt=0
while [ "$probe_attempt" -lt 8 ]; do
    if ping -n -I eth0 -c 1 -W 1 10.12.6.1 >/dev/null 2>&1; then
        break
    fi
    probe_attempt=$((probe_attempt + 1))
    [ "$probe_attempt" -lt 8 ] || break
    sleep 1
done
