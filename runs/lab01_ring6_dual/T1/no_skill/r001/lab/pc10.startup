ip -6 address replace 2001:db8:1100:4::10/64 dev eth0
ip -6 route replace default via 2001:db8:1100:4::1 dev eth0

# Recursive resolver: the only starting point is the private root hint below.
mkdir -p /etc/bind
cat > /etc/bind/named.conf <<'EOF'
options {
    directory "/var/cache/bind";
    listen-on { none; };
    listen-on-v6 { any; };
    recursion yes;
    allow-query { any; };
    allow-recursion { any; };
    dnssec-validation no;
};
zone "." {
    type hint;
    file "/etc/bind/db.root-hints";
};
EOF
cat > /etc/bind/db.root-hints <<'EOF'
. IN NS ns.root.
ns.root. IN AAAA 2001:db8:1100::10
EOF
service named restart 2>/dev/null || service bind9 restart 2>/dev/null || /usr/sbin/named -u bind
