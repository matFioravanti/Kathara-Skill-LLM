ip -6 address replace 2001:db8:1100:3::10/64 dev eth0
ip -6 route replace default via 2001:db8:1100:3::1 dev eth0

# Authoritative-only server for the delegated services.test. child zone.
mkdir -p /etc/bind
cat > /etc/bind/named.conf <<'EOF'
options {
    directory "/var/cache/bind";
    listen-on { none; };
    listen-on-v6 { any; };
    recursion no;
    allow-query { any; };
    dnssec-validation no;
};
zone "services.test" {
    type primary;
    file "/etc/bind/db.services.test";
};
EOF
cat > /etc/bind/db.services.test <<'EOF'
$TTL 300
@   IN SOA ns.services.test. hostmaster.services.test. (
        2026092701 3600 900 1209600 300 )
    IN NS ns.services.test.
ns  IN AAAA 2001:db8:1100:3::10
mail IN AAAA 2001:db8:1100:3::10
status IN AAAA 2001:db8:1100:2::10
EOF
service named restart 2>/dev/null || service bind9 restart 2>/dev/null || /usr/sbin/named -u bind

# IPv6 HTTP endpoint for www.test.
mkdir -p /var/www/html
printf '%s\n' 'www.test IPv6 internal service' > /var/www/html/index.html
service apache2 restart 2>/dev/null || apachectl start
