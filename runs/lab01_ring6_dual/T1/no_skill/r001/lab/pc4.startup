ip -6 address replace 2001:db8:1100:1::10/64 dev eth0
ip -6 route replace default via 2001:db8:1100:1::1 dev eth0
if ! command -v named >/dev/null 2>&1; then
  apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq bind9
fi
if [ -x /etc/init.d/bind9 ]; then
  /etc/init.d/bind9 restart
elif [ -x /etc/init.d/named ]; then
  /etc/init.d/named restart
else
  named -c /etc/bind/named.conf
fi
