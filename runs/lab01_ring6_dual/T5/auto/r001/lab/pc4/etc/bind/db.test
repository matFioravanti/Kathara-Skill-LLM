$TTL 3600
@ IN SOA ns1.test. hostmaster.test. (
  2026092701 3600 900 604800 300 )
@ IN NS ns1.test.
@ IN NS ns2.test.
ns1 IN AAAA 2001:db8:1100:1::10
ns2 IN AAAA 2001:db8:1100:2::10

www IN AAAA 2001:db8:1100:3::10
portal IN AAAA 2001:db8:1100:3::10
@ IN MX 10 mail.services.test.
_http._tcp IN SRV 0 10 80 portal.test.
@ IN TXT "Internal test zone; access via the pc10 recursive resolver"

services IN NS ns.services.test.
ns.services IN AAAA 2001:db8:1100:3::10
