$TTL 3600
@ IN SOA ns.services.test. hostmaster.services.test. (
  2026092701 3600 900 604800 300 )
@ IN NS ns.services.test.
ns IN AAAA 2001:db8:1100:3::10
mail IN AAAA 2001:db8:1100:3::10
status IN AAAA 2001:db8:1100:3::10
@ IN MX 10 mail.services.test.
_submission._tcp IN SRV 0 10 587 mail.services.test.
_http._tcp IN SRV 0 10 80 status.services.test.
@ IN TXT "Authoritative internal services zone"
_dmarc IN TXT "v=DMARC1; p=none"
