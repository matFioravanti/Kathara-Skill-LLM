sysctl -w net.ipv4.ip_forward=1 >/dev/null
sysctl -w net.ipv6.conf.all.forwarding=1 >/dev/null
ip address replace 10.11.3.1/24 dev eth0
ip -6 address replace 2001:db8:1100:3::1/64 dev eth0
ip address replace 172.18.0.10/30 dev eth1
ip -6 address replace 2001:db8:1101:2::2/64 dev eth1
ip address replace 172.18.0.13/30 dev eth2
ip -6 address replace 2001:db8:1101:3::1/64 dev eth2
ip route replace 10.11.0.0/24 via 172.18.0.9 dev eth1
ip route replace 10.11.1.0/24 via 172.18.0.9 dev eth1
ip route replace 10.11.2.0/24 via 172.18.0.9 dev eth1
ip route replace 10.11.4.0/24 via 172.18.0.14 dev eth2
ip route replace 10.11.5.0/24 via 172.18.0.14 dev eth2
ip route replace 172.18.0.0/30 via 172.18.0.9 dev eth1
ip route replace 172.18.0.4/30 via 172.18.0.9 dev eth1
ip route replace 172.18.0.16/30 via 172.18.0.14 dev eth2
ip route replace 172.18.0.20/30 via 172.18.0.14 dev eth2
ip -6 route replace 2001:db8:1100::/64 via 2001:db8:1101:2::1 dev eth1
ip -6 route replace 2001:db8:1100:1::/64 via 2001:db8:1101:2::1 dev eth1
ip -6 route replace 2001:db8:1100:2::/64 via 2001:db8:1101:2::1 dev eth1
ip -6 route replace 2001:db8:1100:4::/64 via 2001:db8:1101:3::2 dev eth2
ip -6 route replace 2001:db8:1100:5::/64 via 2001:db8:1101:3::2 dev eth2
ip -6 route replace 2001:db8:1101::/64 via 2001:db8:1101:2::1 dev eth1
ip -6 route replace 2001:db8:1101:1::/64 via 2001:db8:1101:2::1 dev eth1
ip -6 route replace 2001:db8:1101:4::/64 via 2001:db8:1101:3::2 dev eth2
ip -6 route replace 2001:db8:1101:5::/64 via 2001:db8:1101:3::2 dev eth2
