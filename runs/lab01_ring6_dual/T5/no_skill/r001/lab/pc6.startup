ip -6 address replace 2001:db8:1100:2::10/64 dev eth0
ip -6 route replace default via 2001:db8:1100:2::1 dev eth0
export DEBIAN_FRONTEND=noninteractive
apt-get update -qq && apt-get install -y -qq bind9 dnsutils apache2
mkdir -p /etc/bind /var/cache/bind
chown bind:bind /var/cache/bind
printf '%s\n' \
'options {' '  directory "/var/cache/bind";' '  listen-on { none; };' '  listen-on-v6 { any; };' '  recursion no;' '  allow-query { any; };' '  dnssec-validation no;' '};' \
'zone "test" {' '  type secondary;' '  file "/var/cache/bind/db.test.secondary";' '  primaries { 2001:db8:1100:1::10; };' '};' > /etc/bind/named.conf
named-checkconf && named -c /etc/bind/named.conf
printf '%s\n' '<!doctype html><title>services status</title><h1>services.test status</h1>' > /var/www/html/index.html
service apache2 start
