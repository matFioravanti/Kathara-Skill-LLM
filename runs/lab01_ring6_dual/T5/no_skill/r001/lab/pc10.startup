ip -6 address replace 2001:db8:1100:4::10/64 dev eth0
ip -6 route replace default via 2001:db8:1100:4::1 dev eth0
export DEBIAN_FRONTEND=noninteractive
apt-get update -qq && apt-get install -y -qq bind9 dnsutils
mkdir -p /etc/bind
printf '%s\n' \
'options {' '  directory "/var/cache/bind";' '  listen-on { none; };' '  listen-on-v6 { any; };' '  recursion yes;' '  allow-recursion { any; };' '  allow-query { any; };' '  dnssec-validation no;' '};' \
'zone "." {' '  type hint;' '  file "/etc/bind/db.root.hint";' '};' > /etc/bind/named.conf
printf '%s\n' '. 300 IN NS ns.root.' 'ns.root. 300 IN AAAA 2001:db8:1100::10' > /etc/bind/db.root.hint
named-checkconf && named -c /etc/bind/named.conf
