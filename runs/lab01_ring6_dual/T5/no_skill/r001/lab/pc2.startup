ip -6 address replace 2001:db8:1100::10/64 dev eth0
ip -6 route replace default via 2001:db8:1100::1 dev eth0
export DEBIAN_FRONTEND=noninteractive
apt-get update -qq && apt-get install -y -qq bind9 dnsutils
mkdir -p /etc/bind
printf '%s\n' \
'options {' '  directory "/var/cache/bind";' '  listen-on { none; };' '  listen-on-v6 { any; };' '  recursion no;' '  allow-query { any; };' '  dnssec-validation no;' '};' \
'zone "." {' '  type master;' '  file "/etc/bind/db.root.internal";' '};' > /etc/bind/named.conf
printf '%s\n' \
'$TTL 300' '$ORIGIN .' \
'. IN SOA ns.root. hostmaster.root. ( 2026092701 300 120 1209600 300 )' \
'. IN NS ns.root.' 'ns.root. IN AAAA 2001:db8:1100::10' \
'test. IN NS ns1.test.' 'test. IN NS ns2.test.' \
'ns1.test. IN AAAA 2001:db8:1100:1::10' 'ns2.test. IN AAAA 2001:db8:1100:2::10' > /etc/bind/db.root.internal
named-checkconf && named -c /etc/bind/named.conf
