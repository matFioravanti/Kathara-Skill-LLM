ip -6 address replace 2001:db8:1100:3::10/64 dev eth0
ip -6 route replace default via 2001:db8:1100:3::1 dev eth0
export DEBIAN_FRONTEND=noninteractive
apt-get update -qq && apt-get install -y -qq bind9 dnsutils apache2
mkdir -p /etc/bind
printf '%s\n' \
'options {' '  directory "/var/cache/bind";' '  listen-on { none; };' '  listen-on-v6 { any; };' '  recursion no;' '  allow-query { any; };' '  dnssec-validation no;' '};' \
'zone "services.test" {' '  type master;' '  file "/etc/bind/db.services.test";' '};' > /etc/bind/named.conf
printf '%s\n' \
'$TTL 300' '$ORIGIN services.test.' \
'@ IN SOA ns.services.test. hostmaster.services.test. ( 2026092701 300 120 1209600 300 )' \
'@ IN NS ns.services.test.' 'ns IN AAAA 2001:db8:1100:3::10' \
'mail IN AAAA 2001:db8:1100:3::10' 'status IN AAAA 2001:db8:1100:2::10' > /etc/bind/db.services.test
named-checkconf && named -c /etc/bind/named.conf
printf '%s\n' '<!doctype html><title>www.test</title><h1>www.test</h1>' > /var/www/html/index.html
service apache2 start
