$TTL 3600
@ IN SOA ns1.test. hostmaster.test. ( 1 3600 900 604800 300 )
@ IN NS ns1.test.
@ IN NS ns2.test.
ns1 IN AAAA 2001:db8:1100:1::10
ns2 IN AAAA 2001:db8:1100:2::10

www IN A 10.11.0.10
portal IN A 10.11.1.10
mail IN A 10.11.2.10
@ IN MX 10 mail.test.
_http._tcp IN SRV 10 5 80 www.test.
@ IN TXT "benchmark=dns-advanced"

services IN NS ns.services.test.
ns.services IN AAAA 2001:db8:1100:3::10
