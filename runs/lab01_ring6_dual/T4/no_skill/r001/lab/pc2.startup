ip -6 address replace 2001:db8:1100::10/64 dev eth0
ip -6 route replace default via 2001:db8:1100::1 dev eth0
mkdir -p /etc/bind/zones
printf '%s\n' 'options {' '  directory "/etc/bind";' '  listen-on { any; };' '  listen-on-v6 { any; };' '  recursion no;' '  dnssec-validation no;' '};' 'zone "." {' '  type master;' '  file "/etc/bind/zones/db.root";' '};' > /etc/bind/named.conf
printf '%s\n' '$TTL 3600' '@ IN SOA ns.root. hostmaster.root. ( 2026092701 3600 900 604800 300 )' '@ IN NS ns.root.' 'ns.root. IN AAAA 2001:db8:1100::10' 'test. IN NS ns1.test.' 'test. IN NS ns2.test.' 'ns1.test. IN AAAA 2001:db8:1100:1::10' 'ns2.test. IN AAAA 2001:db8:1100:2::10' > /etc/bind/zones/db.root
service named restart
