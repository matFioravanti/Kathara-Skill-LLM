ip -6 address replace 2001:db8:1100:4::10/64 dev eth0
ip -6 route replace default via 2001:db8:1100:4::1 dev eth0
mkdir -p /etc/bind
printf '%s\n' 'options {' '  directory "/etc/bind";' '  listen-on { any; };' '  listen-on-v6 { any; };' '  recursion yes;' '  allow-recursion { any; };' '  dnssec-validation no;' '};' 'zone "." {' '  type hint;' '  file "/etc/bind/root.hint";' '};' > /etc/bind/named.conf
printf '%s\n' '. 3600 IN NS ns.root.' 'ns.root. 3600 IN AAAA 2001:db8:1100::10' > /etc/bind/root.hint
service named restart
