ip -6 address replace 2001:db8:1100:4::10/64 dev eth0
ip -6 route replace default via 2001:db8:1100:4::1 dev eth0
mkdir -p /etc/bind
cat > /etc/bind/named.conf <<'EOF'
options {
    directory "/etc/bind";
    listen-on { any; };
    listen-on-v6 { any; };
    recursion yes;
    allow-query { any; };
    allow-recursion { any; };
    dnssec-validation no;
};
zone "." { type hint; file "/etc/bind/root.hints"; };
EOF
cat > /etc/bind/root.hints <<'EOF'
. IN NS ns.root.
ns.root. IN AAAA 2001:db8:1100::10
EOF
named -c /etc/bind/named.conf
