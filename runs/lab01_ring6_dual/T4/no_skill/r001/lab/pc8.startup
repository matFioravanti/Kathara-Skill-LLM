ip -6 address replace 2001:db8:1100:3::10/64 dev eth0
ip -6 route replace default via 2001:db8:1100:3::1 dev eth0
mkdir -p /etc/bind/zones
printf '%s\n' 'options {' '  directory "/etc/bind";' '  listen-on { any; };' '  listen-on-v6 { any; };' '  recursion no;' '  dnssec-validation no;' '};' 'zone "services.test" {' '  type master;' '  file "/etc/bind/zones/db.services.test";' '};' > /etc/bind/named.conf
printf '%s\n' '$TTL 3600' '@ IN SOA ns.services.test. hostmaster.services.test. ( 2026092701 3600 900 604800 300 )' '@ IN NS ns.services.test.' 'ns IN AAAA 2001:db8:1100:3::10' 'mail IN AAAA 2001:db8:1100:3::10' 'status IN AAAA 2001:db8:1100:2::10' > /etc/bind/zones/db.services.test
service named restart
service apache2 restart
