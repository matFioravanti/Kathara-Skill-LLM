ip -6 address replace 2001:db8:1100:1::10/64 dev eth0
ip -6 route replace default via 2001:db8:1100:1::1 dev eth0
export DEBIAN_FRONTEND=noninteractive
apt-get update -qq && apt-get install -y -qq bind9 dnsutils
install -d /etc/bind/zones
printf '%s\n' \
'options {' '  directory "/var/cache/bind";' '  listen-on { none; };' '  listen-on-v6 { any; };' '  recursion no;' '  allow-query { any; };' '  dnssec-validation no;' '};' \
'zone "test" {' '  type primary;' '  file "/etc/bind/zones/db.test";' '  allow-transfer { 2001:db8:1100:2::10; };' '  also-notify { 2001:db8:1100:2::10; };' '  notify yes;' '};' > /etc/bind/named.conf
printf '%s\n' \
'$TTL 300' \
'@ IN SOA ns1.test. hostmaster.test. ( 2026092701 3600 900 604800 300 )' \
'@ IN NS ns1.test.' '@ IN NS ns2.test.' \
'ns1 IN AAAA 2001:db8:1100:1::10' 'ns2 IN AAAA 2001:db8:1100:2::10' \
'www IN A 10.11.5.10' 'www IN AAAA 2001:db8:1100:3::10' \
'portal IN CNAME www.test.' '@ IN MX 10 mail.services.test.' \
'_http._tcp IN SRV 0 5 80 www.test.' '@ IN TXT "benchmark=dns-advanced"' \
'services IN NS ns.services.test.' 'ns.services IN AAAA 2001:db8:1100:3::10' > /etc/bind/zones/db.test
named-checkconf && named-checkzone test /etc/bind/zones/db.test
service bind9 restart
