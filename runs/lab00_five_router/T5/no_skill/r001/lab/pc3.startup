ip address add 100.0.0.2/24 dev eth0
ip route add default via 100.0.0.1 dev eth0
ip address add 2001:8::2/64 dev eth0
apt-get update
DEBIAN_FRONTEND=noninteractive apt-get install -y bind9
printf '%s\n' \
  'options {' \
  '  directory "/var/cache/bind";' \
  '  listen-on { 100.0.0.2; };' \
  '  listen-on-v6 { 2001:8::2; };' \
  '  recursion yes;' \
  '  allow-query { any; };' \
  '  dnssec-validation no;' \
  '};' \
  'zone "." {' \
  '  type hint;' \
  '  file "/etc/bind/root.hints";' \
  '};' > /etc/bind/named.conf
printf '%s\n' \
  '. IN NS ns.root.' \
  'ns.root. IN A 100.0.6.2' > /etc/bind/root.hints
named-checkconf
named -c /etc/bind/named.conf
