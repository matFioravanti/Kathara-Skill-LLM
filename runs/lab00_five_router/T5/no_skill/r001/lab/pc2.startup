ip address add 100.0.6.2/24 dev eth0
ip route add default via 100.0.6.1 dev eth0
apt-get update
DEBIAN_FRONTEND=noninteractive apt-get install -y bind9
mkdir -p /etc/bind/zones
printf '%s\n' \
  'options {' \
  '  directory "/var/cache/bind";' \
  '  listen-on { 100.0.6.2; };' \
  '  listen-on-v6 { none; };' \
  '  recursion no;' \
  '  dnssec-validation no;' \
  '};' \
  'zone "." {' \
  '  type master;' \
  '  file "/etc/bind/zones/db.root";' \
  '};' > /etc/bind/named.conf
printf '%s\n' \
  '$TTL 300' \
  '$ORIGIN .' \
  '@ IN SOA ns.root. hostmaster.root. ( 1 3600 900 604800 300 )' \
  '@ IN NS ns.root.' \
  'ns.root. IN A 100.0.6.2' \
  'test. IN NS ns.test.' \
  'ns.test. IN A 100.0.8.2' > /etc/bind/zones/db.root
named-checkconf
named-checkzone . /etc/bind/zones/db.root
named -c /etc/bind/named.conf
