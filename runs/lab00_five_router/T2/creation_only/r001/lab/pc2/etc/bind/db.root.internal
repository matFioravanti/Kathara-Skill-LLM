$TTL 86400
@       IN      SOA     ns.root. hostmaster.root. (
                        2026092501  ; serial
                        3600        ; refresh
                        900         ; retry
                        604800      ; expire
                        86400 )     ; negative cache TTL

@       IN      NS      ns.root.
ns.root. IN     A       100.0.6.2

test.   IN      NS      ns.test.
ns.test. IN     A       100.0.8.2
