ip address add 100.0.6.2/24 dev eth0
ip route add default via 100.0.6.1 dev eth0

# Authoritative-only server for the DNS root zone.
mkdir -p /etc/bind
cat > /etc/bind/named.conf <<'EOF'
options {
    directory "/var/cache/bind";
    listen-on { 100.0.6.2; };
    listen-on-v6 { none; };
    recursion no;
    allow-query { any; };
    dnssec-validation no;
};

zone "." {
    type master;
    file "/etc/bind/db.root.internal";
};
EOF

cat > /etc/bind/db.root.internal <<'EOF'
$TTL 300
@       IN SOA  ns.root. hostmaster.root. (
                2026092501 3600 900 604800 300 )
        IN NS   ns.root.
ns.root. IN A   100.0.6.2

test.   IN NS   ns.test.
ns.test. IN A   100.0.8.2
EOF

named-checkconf && named-checkzone . /etc/bind/db.root.internal && named -c /etc/bind/named.conf
