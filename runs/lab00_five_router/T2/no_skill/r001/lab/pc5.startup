ip address add 100.0.8.2/24 dev eth0
ip route add default via 100.0.8.1 dev eth0

# Authoritative-only server for test.
mkdir -p /etc/bind
cat > /etc/bind/named.conf <<'EOF'
options {
    directory "/var/cache/bind";
    listen-on { 100.0.8.2; };
    listen-on-v6 { none; };
    recursion no;
    allow-query { any; };
    dnssec-validation no;
};

zone "test." {
    type master;
    file "/etc/bind/db.test";
};
EOF

cat > /etc/bind/db.test <<'EOF'
$TTL 300
@       IN SOA  ns.test. hostmaster.test. (
                2026092501 3600 900 604800 300 )
        IN NS   ns.test.
ns      IN A    100.0.8.2
www     IN A    200.0.1.2
EOF

named-checkconf && named-checkzone test. /etc/bind/db.test && named -c /etc/bind/named.conf
