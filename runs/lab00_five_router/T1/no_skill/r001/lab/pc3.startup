ip address add 100.0.0.2/24 dev eth0
ip route add default via 100.0.0.1 dev eth0
ip address add 2001:8::2/64 dev eth0

# Recursive resolver; its only bootstrap data is the internal root hint.
apt-get update
DEBIAN_FRONTEND=noninteractive apt-get install -y bind9 dnsutils
install -m 0644 /root/dns/named.conf /etc/bind/named.conf
install -m 0644 /root/dns/db.internal-root-hints /etc/bind/db.internal-root-hints
service bind9 restart
