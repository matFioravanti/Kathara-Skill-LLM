ip address add 100.0.6.2/24 dev eth0
ip route add default via 100.0.6.1 dev eth0

# Authoritative-only server for the internal DNS root.
apt-get update
DEBIAN_FRONTEND=noninteractive apt-get install -y bind9
install -m 0644 /root/dns/named.conf /etc/bind/named.conf
install -m 0644 /root/dns/db.internal-root /etc/bind/db.internal-root
service bind9 restart
