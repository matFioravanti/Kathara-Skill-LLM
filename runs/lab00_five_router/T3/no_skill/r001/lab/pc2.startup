ip address add 100.0.6.2/24 dev eth0
ip route add default via 100.0.6.1 dev eth0

# Authoritative root server.  It delegates test. to pc5 and supplies its glue.
apt-get update
DEBIAN_FRONTEND=noninteractive apt-get install -y bind9
install -d /etc/bind
printf '%s\n' \
  'options {' \
  '    directory "/var/cache/bind";' \
  '    listen-on { any; };' \
  '    listen-on-v6 { none; };' \
  '    recursion no;' \
  '};' \
  'zone "." {' \
  '    type master;' \
  '    file "/etc/bind/db.root.internal";' \
  '};' > /etc/bind/named.conf
printf '%s\n' \
  '$TTL 86400' \
  '@ IN SOA ns.root. hostmaster.root. ( 1 3600 900 604800 86400 )' \
  '@ IN NS ns.root.' \
  'ns.root. IN A 100.0.6.2' \
  'test. IN NS ns.test.' \
  'ns.test. IN A 100.0.8.2' > /etc/bind/db.root.internal
service bind9 restart
