options {
    directory "/tmp";
    listen-on port 53 { any; };
    listen-on-v6 { none; };
    recursion yes;
    allow-query { any; };
    allow-recursion { any; };
    allow-query-cache { any; };
    dnssec-validation no;
    empty-zones-enable no;
    pid-file "/run/named-lab.pid";
};
zone "." { type hint; file "/etc/bind/db.lab-root"; };
