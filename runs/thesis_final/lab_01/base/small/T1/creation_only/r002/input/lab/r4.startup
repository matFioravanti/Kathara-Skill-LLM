#!/bin/sh
set -eu
# Kathara: interfacce gia attive, solo IPv4 e routing statico.
ip -4 address show dev eth0 | grep -Fq 'inet 10.14.6.1/24 ' || ip address add 10.14.6.1/24 dev eth0
ip -4 address show dev eth1 | grep -Fq 'inet 172.24.1.10/30 ' || ip address add 172.24.1.10/30 dev eth1

# Rotte MANUALI: non avviare alcun protocollo di routing.
ip route replace 10.14.1.0/24 via 172.24.1.9 dev eth1
ip route replace 10.14.2.0/24 via 172.24.1.9 dev eth1
ip route replace 10.14.3.0/24 via 172.24.1.9 dev eth1
ip route replace 10.14.4.0/24 via 172.24.1.9 dev eth1
ip route replace 10.14.5.0/24 via 172.24.1.9 dev eth1
ip route replace 172.24.1.0/30 via 172.24.1.9 dev eth1
ip route replace 172.24.1.4/30 via 172.24.1.9 dev eth1

# ARP statico limitato ai vicini sul medesimo dominio L2.
ip -4 neigh replace 10.14.6.11 lladdr 02:00:00:0a:06:02 nud permanent dev eth0
ip -4 neigh replace 10.14.6.12 lladdr 02:00:00:0a:06:03 nud permanent dev eth0
ip -4 neigh replace 10.14.6.13 lladdr 02:00:00:0a:06:04 nud permanent dev eth0
ip -4 neigh replace 172.24.1.9 lladdr 02:00:00:0b:34:03 nud permanent dev eth1
