#!/bin/sh
set -eu
# Kathara: interfacce gia attive, solo IPv4 e routing statico.
ip -4 address show dev eth0 | grep -Fq 'inet 10.14.5.13/24 ' || ip address add 10.14.5.13/24 dev eth0

ip route replace default via 10.14.5.1 dev eth0

# ARP statico limitato ai vicini sul medesimo dominio L2.
ip -4 neigh replace 10.14.5.1 lladdr 02:00:00:0a:05:01 nud permanent dev eth0
ip -4 neigh replace 10.14.5.11 lladdr 02:00:00:0a:05:02 nud permanent dev eth0
ip -4 neigh replace 10.14.5.12 lladdr 02:00:00:0a:05:03 nud permanent dev eth0

# Stabilizzazione del gateway (massimo 8 tentativi, mai fatale).
probe_attempt=0
while [ "$probe_attempt" -lt 8 ]; do
    if ping -n -I eth0 -c 1 -W 1 10.14.5.1 >/dev/null 2>&1; then
        break
    fi
    probe_attempt=$((probe_attempt + 1))
    [ "$probe_attempt" -lt 8 ] || break
    sleep 1
done

# Usa il resolver DNS del laboratorio.
printf 'nameserver 10.14.4.14\n' > /etc/resolv.conf
