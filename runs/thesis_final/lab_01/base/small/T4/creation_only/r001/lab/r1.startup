#!/bin/sh
set -eu
# Kathara: interfacce gia attive, solo IPv4 e routing statico.
ip -4 address show dev eth0 | grep -Fq 'inet 10.14.1.1/24 ' || ip address add 10.14.1.1/24 dev eth0
ip -4 address show dev eth1 | grep -Fq 'inet 10.14.2.1/24 ' || ip address add 10.14.2.1/24 dev eth1
ip -4 address show dev eth2 | grep -Fq 'inet 172.24.1.1/30 ' || ip address add 172.24.1.1/30 dev eth2

# Rotte MANUALI: non avviare alcun protocollo di routing.
ip route replace 10.14.3.0/24 via 172.24.1.2 dev eth2
ip route replace 10.14.4.0/24 via 172.24.1.2 dev eth2
ip route replace 10.14.5.0/24 via 172.24.1.2 dev eth2
ip route replace 10.14.6.0/24 via 172.24.1.2 dev eth2
ip route replace 172.24.1.4/30 via 172.24.1.2 dev eth2
ip route replace 172.24.1.8/30 via 172.24.1.2 dev eth2

# ARP statico limitato ai vicini sul medesimo dominio L2.
ip -4 neigh replace 10.14.1.11 lladdr 02:00:00:0a:01:02 nud permanent dev eth0
ip -4 neigh replace 10.14.1.12 lladdr 02:00:00:0a:01:03 nud permanent dev eth0
ip -4 neigh replace 10.14.1.13 lladdr 02:00:00:0a:01:04 nud permanent dev eth0
ip -4 neigh replace 10.14.1.14 lladdr 02:00:00:0a:01:05 nud permanent dev eth0
ip -4 neigh replace 10.14.2.11 lladdr 02:00:00:0a:02:02 nud permanent dev eth1
ip -4 neigh replace 10.14.2.12 lladdr 02:00:00:0a:02:03 nud permanent dev eth1
ip -4 neigh replace 10.14.2.13 lladdr 02:00:00:0a:02:04 nud permanent dev eth1
ip -4 neigh replace 172.24.1.2 lladdr 02:00:00:0b:12:02 nud permanent dev eth2

# Server DNS autorevole per i domini del laboratorio.
systemctl restart bind9
