ip address replace 10.33.0.202/26 dev eth0
ip route replace default via 10.33.0.193 dev eth0
mkdir -p /etc/bind
cat > /etc/bind/named.conf <<'EOF'
options {
    directory "/var/cache/bind";
    listen-on { any; };
    listen-on-v6 { none; };
    recursion no;
    allow-query { any; };
};
zone "services.test." {
    type master;
    file "/etc/bind/db.services.test";
};
EOF
cat > /etc/bind/db.services.test <<'EOF'
$TTL 300
@ IN SOA ns.services.test. hostmaster.services.test. ( 1 300 120 604800 300 )
  IN NS ns.services.test.
ns IN A 10.33.0.202
mail IN A 10.33.0.202
status IN A 10.33.1.202
EOF
rndc reconfig || service named restart
