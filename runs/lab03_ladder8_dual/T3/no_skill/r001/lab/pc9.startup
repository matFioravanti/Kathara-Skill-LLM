ip address replace 10.33.1.10/26 dev eth0
ip route replace default via 10.33.1.1 dev eth0
mkdir -p /etc/bind
cat > /etc/bind/named.conf <<'EOF'
options {
    directory "/var/cache/bind";
    listen-on { any; };
    listen-on-v6 { none; };
    recursion yes;
    allow-recursion { any; };
    allow-query { any; };
    forwarders { };
};
zone "." {
    type hint;
    file "/etc/bind/db.root-hints";
};
EOF
cat > /etc/bind/db.root-hints <<'EOF'
. 300 IN NS ns.root.
ns.root. 300 IN A 10.33.0.10
EOF
rndc reconfig || service named restart
