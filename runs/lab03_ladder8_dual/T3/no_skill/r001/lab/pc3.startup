ip address replace 10.33.0.74/26 dev eth0
ip route replace default via 10.33.0.65 dev eth0
mkdir -p /etc/bind
cat > /etc/bind/named.conf <<'EOF'
options {
    directory "/var/cache/bind";
    listen-on { any; };
    listen-on-v6 { none; };
    recursion no;
    allow-query { any; };
};
zone "test." {
    type master;
    file "/etc/bind/db.test";
    allow-transfer { 10.33.0.138; };
    also-notify { 10.33.0.138; };
    notify yes;
};
EOF
cat > /etc/bind/db.test <<'EOF'
$TTL 300
@ IN SOA ns1.test. hostmaster.test. ( 1 300 120 604800 300 )
  IN NS ns1.test.
  IN NS ns2.test.
ns1 IN A 10.33.0.74
ns2 IN A 10.33.0.138
www IN A 10.33.1.138
www IN AAAA 2001:db8:1300:7::10
portal IN CNAME www
@ IN MX 10 mail.services.test.
@ IN TXT "benchmark=dns-advanced"
services IN NS ns.services.test.
ns.services IN A 10.33.0.202
EOF
rndc reconfig || service named restart
