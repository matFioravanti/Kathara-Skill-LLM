ip address replace 192.168.34.138/25 dev eth0
ip route replace default via 192.168.34.129 dev eth0
ip -6 address replace 2001:db8:1200:5::10/64 dev eth0
ip -6 route replace default via 2001:db8:1200:5::1 dev eth0
export DEBIAN_FRONTEND=noninteractive
apt-get update -qq && apt-get install -y -qq bind9 dnsutils
mkdir -p /etc/bind
printf '%s\n' \
'options { directory "/var/cache/bind"; listen-on { any; }; listen-on-v6 { any; }; recursion yes; allow-recursion { any; }; dnssec-validation no; };' \
'zone "." { type hint; file "/etc/bind/db.root-hints"; };' > /etc/bind/named.conf
printf '%s\n' \
'. 300 IN NS ns.root.' \
'ns.root. 300 IN A 192.168.32.11' > /etc/bind/db.root-hints
service bind9 restart
