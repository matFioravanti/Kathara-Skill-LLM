ip address replace 192.168.34.139/25 dev eth0
ip route replace default via 192.168.34.129 dev eth0
export DEBIAN_FRONTEND=noninteractive
apt-get update -qq && apt-get install -y -qq bind9 dnsutils
mkdir -p /etc/bind/zones
printf '%s\n' \
'options { directory "/var/cache/bind"; listen-on { any; }; listen-on-v6 { none; }; recursion no; };' \
'zone "services.test" { type primary; file "/etc/bind/zones/db.services.test"; };' > /etc/bind/named.conf
printf '%s\n' \
'$TTL 300' \
'@ IN SOA ns.services.test. hostmaster.services.test. ( 2026092701 300 120 1209600 300 )' \
'@ IN NS ns.services.test.' \
'ns IN A 192.168.34.139' \
'mail IN A 192.168.34.139' \
'status IN A 192.168.32.10' > /etc/bind/zones/db.services.test
service bind9 restart
