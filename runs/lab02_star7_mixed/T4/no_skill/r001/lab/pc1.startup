ip address replace 192.168.32.10/25 dev eth0
ip route replace default via 192.168.32.1 dev eth0
ip -6 address replace 2001:db8:1200::10/64 dev eth0
ip -6 route replace default via 2001:db8:1200::1 dev eth0
export DEBIAN_FRONTEND=noninteractive
apt-get update -qq && apt-get install -y -qq apache2
service apache2 restart
