$TTL 3600
@ IN SOA ns1.test. hostmaster.test. ( 1 3600 900 604800 300 )
@ IN NS ns1.test.
@ IN NS ns2.test.
ns1 IN AAAA 2001:db8:1200:1::10
ns2 IN AAAA 2001:db8:1200:4::10
services IN NS ns.services.test.
ns.services IN A 192.168.34.139
www IN A 192.168.34.138
www IN AAAA 2001:db8:1200:5::10
portal IN A 192.168.34.138
portal IN AAAA 2001:db8:1200:5::10
@ IN MX 10 mail.services.test.
_http._tcp IN SRV 10 5 80 www.test.
_https._tcp IN SRV 10 5 80 portal.test.
@ IN TXT "Internal test zone; services available through pc11"
