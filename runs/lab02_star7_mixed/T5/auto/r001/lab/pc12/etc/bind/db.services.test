$TTL 3600
@                       IN SOA  ns.services.test. hostmaster.services.test. (
                                1 3600 900 604800 300 )
                        IN NS   ns.services.test.
ns                      IN A    192.168.34.139
mail                    IN A    192.168.34.139
status                  IN A    192.168.34.139
@                       IN MX 10 mail.services.test.
_smtp._tcp              IN SRV 10 10 25 mail.services.test.
_http._tcp              IN SRV 10 10 80 status.services.test.
@                       IN TXT "Internal services zone"
