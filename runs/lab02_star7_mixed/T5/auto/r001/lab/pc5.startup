ip address replace 192.168.33.10/25 dev eth0
ip route replace default via 192.168.33.1 dev eth0
ip -6 address replace 2001:db8:1200:2::10/64 dev eth0
ip -6 route replace default via 2001:db8:1200:2::1 dev eth0
mkdir -p /var/www/portal.test
printf '%s\\n' '<!doctype html><title>portal.test</title><h1>portal.test</h1>' > /var/www/portal.test/index.html
python3 -m http.server 80 --directory /var/www/portal.test >/var/log/portal.test-http.log 2>&1 &
