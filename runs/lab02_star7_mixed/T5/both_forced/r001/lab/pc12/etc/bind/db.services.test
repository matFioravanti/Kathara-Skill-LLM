$TTL 3600
@ IN SOA ns.services.test. hostmaster.services.test. ( 1 3600 900 604800 300 )
@ IN NS ns.services.test.
ns IN A 192.168.34.139

mail IN A 192.168.32.10
mail IN AAAA 2001:db8:1200::10
status IN A 192.168.33.10
status IN AAAA 2001:db8:1200:2::10
@ IN MX 10 mail.services.test.
_submission._tcp IN SRV 10 10 587 mail.services.test.
_http._tcp IN SRV 10 10 80 status.services.test.
@ IN TXT "Internal service discovery zone"
