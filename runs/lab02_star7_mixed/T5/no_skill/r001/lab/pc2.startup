ip address replace 192.168.32.11/25 dev eth0
ip route replace default via 192.168.32.1 dev eth0

# Internal root server.  It delegates only the laboratory TLD.
mkdir -p /etc/bind/zones
tee /etc/bind/named.conf >/dev/null <<'EOF'
options {
    directory "/var/cache/bind";
    listen-on { any; };
    listen-on-v6 { none; };
    recursion no;
    allow-query { any; };
};
zone "." { type master; file "/etc/bind/zones/db.root"; };
EOF
tee /etc/bind/zones/db.root >/dev/null <<'EOF'
$TTL 3600
@ IN SOA ns.root. hostmaster.root. (2026092901 3600 900 604800 300)
  IN NS ns.root.
ns.root. IN A 192.168.32.11
test. IN NS ns1.test.
test. IN NS ns2.test.
ns1.test. IN AAAA 2001:db8:1200:1::10
ns2.test. IN AAAA 2001:db8:1200:4::10
EOF
named-checkconf && named-checkzone . /etc/bind/zones/db.root && named -c /etc/bind/named.conf
