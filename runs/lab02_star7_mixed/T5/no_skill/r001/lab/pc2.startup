ip address replace 192.168.32.11/25 dev eth0
ip route replace default via 192.168.32.1 dev eth0
mkdir -p /etc/bind
printf '%s\n' 'options {' '  directory "/var/cache/bind";' '  listen-on { any; };' '  listen-on-v6 { none; };' '  allow-query { any; };' '  recursion no;' '  dnssec-validation no;' '};' 'zone "." {' '  type master;' '  file "/etc/bind/db.root";' '};' > /etc/bind/named.conf
printf '%s\n' '$TTL 300' '@ IN SOA ns.root. hostmaster.root. ( 2026092701 3600 900 604800 300 )' '@ IN NS ns.root.' 'ns.root. IN A 192.168.32.11' 'test. IN NS ns1.test.' 'test. IN NS ns2.test.' 'ns1.test. IN AAAA 2001:db8:1200:1::10' 'ns2.test. IN AAAA 2001:db8:1200:4::10' > /etc/bind/db.root
service bind9 restart 2>/dev/null || service named restart
