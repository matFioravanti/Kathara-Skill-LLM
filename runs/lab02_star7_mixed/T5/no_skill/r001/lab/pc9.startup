ip -6 address replace 2001:db8:1200:4::10/64 dev eth0
ip -6 route replace default via 2001:db8:1200:4::1 dev eth0
mkdir -p /etc/bind /var/cache/bind
printf '%s\n' 'options {' '  directory "/var/cache/bind";' '  listen-on { any; };' '  listen-on-v6 { any; };' '  allow-query { any; };' '  recursion no;' '  dnssec-validation no;' '};' 'zone "test" {' '  type slave;' '  file "/var/cache/bind/db.test";' '  masters { 2001:db8:1200:1::10; };' '};' > /etc/bind/named.conf
for attempt in $(seq 1 20); do dig @2001:db8:1200:1::10 test. SOA +short >/dev/null 2>&1 && break; sleep 1; done
service bind9 restart 2>/dev/null || service named restart
