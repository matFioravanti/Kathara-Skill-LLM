ip -6 address replace 2001:db8:1200:4::10/64 dev eth0
ip -6 route replace default via 2001:db8:1200:4::1 dev eth0

# Secondary authoritative server for test.; it loads the zone by AXFR from pc3.
mkdir -p /etc/bind/zones /var/cache/bind
tee /etc/bind/named.conf >/dev/null <<'EOF'
options {
    directory "/var/cache/bind";
    listen-on { none; };
    listen-on-v6 { any; };
    recursion no;
    allow-query { any; };
};
zone "test" {
    type slave;
    file "/var/cache/bind/db.test";
    masters { 2001:db8:1200:1::10; };
};
EOF
named-checkconf && named -c /etc/bind/named.conf
