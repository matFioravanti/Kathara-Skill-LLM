ip -6 address replace 2001:db8:1200:1::10/64 dev eth0
ip -6 route replace default via 2001:db8:1200:1::1 dev eth0
mkdir -p /etc/bind
printf '%s\n' 'options {' '  directory "/var/cache/bind";' '  listen-on { any; };' '  listen-on-v6 { any; };' '  allow-query { any; };' '  recursion no;' '  dnssec-validation no;' '};' 'zone "test" {' '  type master;' '  file "/etc/bind/db.test";' '  allow-transfer { 2001:db8:1200:4::10; };' '  also-notify { 2001:db8:1200:4::10; };' '};' > /etc/bind/named.conf
printf '%s\n' '$TTL 300' '@ IN SOA ns1.test. hostmaster.test. ( 2026092701 3600 900 604800 300 )' '@ IN NS ns1.test.' '@ IN NS ns2.test.' 'ns1 IN AAAA 2001:db8:1200:1::10' 'ns2 IN AAAA 2001:db8:1200:4::10' 'www IN A 192.168.33.138' 'www IN AAAA 2001:db8:1200:4::11' 'portal IN CNAME www.test.' '@ IN MX 10 mail.services.test.' '_http._tcp IN SRV 0 5 80 www.test.' '@ IN TXT "benchmark=dns-advanced"' 'services IN NS ns.services.test.' 'ns.services IN A 192.168.34.139' > /etc/bind/db.test
service bind9 restart 2>/dev/null || service named restart
