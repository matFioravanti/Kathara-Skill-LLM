ip address replace 192.168.34.138/25 dev eth0
ip route replace default via 192.168.34.129 dev eth0
ip -6 address replace 2001:db8:1200:5::10/64 dev eth0
ip -6 route replace default via 2001:db8:1200:5::1 dev eth0

# Recursive resolver: start its resolution at the internal root, never externally.
mkdir -p /etc/bind
tee /etc/bind/named.conf >/dev/null <<'EOF'
options {
    directory "/var/cache/bind";
    listen-on { any; };
    listen-on-v6 { any; };
    recursion yes;
    allow-recursion { any; };
    allow-query { any; };
    empty-zones-enable no;
};
zone "." { type hint; file "/etc/bind/db.root"; };
EOF
tee /etc/bind/db.root >/dev/null <<'EOF'
. IN NS ns.root.
ns.root. IN A 192.168.32.11
EOF
named-checkconf && named -c /etc/bind/named.conf
