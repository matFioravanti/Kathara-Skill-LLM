sysctl -w net.ipv4.ip_forward=1 >/dev/null
sysctl -w net.ipv6.conf.all.forwarding=1 >/dev/null
ip address replace 10.22.0.1/30 dev eth0
ip -6 address replace 2001:db8:1201::1/64 dev eth0
ip address replace 10.22.0.5/30 dev eth1
ip -6 address replace 2001:db8:1201:1::1/64 dev eth1
ip address replace 10.22.0.9/30 dev eth2
ip -6 address replace 2001:db8:1201:2::1/64 dev eth2
ip address replace 10.22.0.13/30 dev eth3
ip -6 address replace 2001:db8:1201:3::1/64 dev eth3
ip address replace 10.22.0.17/30 dev eth4
ip -6 address replace 2001:db8:1201:4::1/64 dev eth4
ip address replace 10.22.0.21/30 dev eth5
ip -6 address replace 2001:db8:1201:5::1/64 dev eth5
ip route replace 192.168.32.0/25 via 10.22.0.2 dev eth0
ip route replace 192.168.32.128/25 via 10.22.0.6 dev eth1
ip route replace 192.168.33.0/25 via 10.22.0.10 dev eth2
ip route replace 192.168.33.128/25 via 10.22.0.14 dev eth3
ip route replace 192.168.34.0/25 via 10.22.0.18 dev eth4
ip route replace 192.168.34.128/25 via 10.22.0.22 dev eth5
ip -6 route replace 2001:db8:1200::/64 via 2001:db8:1201::2 dev eth0
ip -6 route replace 2001:db8:1200:1::/64 via 2001:db8:1201:1::2 dev eth1
ip -6 route replace 2001:db8:1200:2::/64 via 2001:db8:1201:2::2 dev eth2
ip -6 route replace 2001:db8:1200:3::/64 via 2001:db8:1201:3::2 dev eth3
ip -6 route replace 2001:db8:1200:4::/64 via 2001:db8:1201:4::2 dev eth4
ip -6 route replace 2001:db8:1200:5::/64 via 2001:db8:1201:5::2 dev eth5
